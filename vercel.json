{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/game", "dest": "/game.html" },
    { "src": "/leaderboard", "dest": "/leaderboard.html" },
    { "src": "/tokenomics", "dest": "/tokenomics.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
